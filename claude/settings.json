{
  "env": {
    "GUSTO_CLAUDE_SETUP": "true"
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(jq *)",
      "Bash(mkdir *)",
      "Bash(pbcopy *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git config --get *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(ruby -c *)",
      "Bash(bundle exec rspec *)",
      "Bash(bin/rspec *)",
      "Bash(bin/rubocop *)",
      "Bash(bin/srb *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(bats *)",
      "Bash(tmux *)",
      "Bash(mise ls *)",
      "Bash(mise ls-remote *)",
      "Bash(bktide *)",
      "Bash(bash ~/.claude/skills/hub/scripts/*)",
      "Bash(~/.claude/skills/hub/scripts/*)",
      "mcp__claude_ai_Gdrive_Gusto__create_file"
    ],
    "ask": [
      "Bash(rm *)"
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "npx -y @owloops/claude-powerline@latest --style=powerline"
  },
  "enabledPlugins": {
    "gusto-setup-wizard@gusto-claude-code": true,
    "gusto-architecture@gusto-claude-code": true,
    "gerold@gusto-claude-code": true,
    "jira-acli@gusto-claude-code": true,
    "gh-cli@gusto-claude-code": true,
    "claude-tmux-attention@gusto-claude-code": true,
    "Notion@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/hub/scripts/hub-stop-hook.sh"
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "tui": "default",
  "theme": "light-daltonized",
  "editorMode": "vim"
}
