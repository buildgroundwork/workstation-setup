{
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(jq *)",
      "Bash(mkdir *)",
      "Bash(pbcopy *)",
      "Bash(rm -f /private/tmp/*)",
      "Bash(rm -rf /private/tmp/*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git config --get *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(ruby -c *)",
      "Bash(bundle exec rspec *)",
      "Bash(bin/rspec *)",
      "Bash(bin/rubocop *)",
      "Bash(bin/srb *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(bats *)",
      "Bash(tmux *)",
      "Bash(brew info *)",
      "Bash(brew list *)",
      "Bash(brew tap)",
      "Bash(brew --prefix*)",
      "Bash(brew --version)",
      "Bash(mise ls *)",
      "Bash(mise ls-remote *)",
      "Bash(bash ~/.claude/skills/hub/scripts/*)",
      "Bash(~/.claude/skills/hub/scripts/*)",
      "Bash(isend:*)",
      "Bash(iflag:*)",
      "Bash(ilist:*)",
      "Bash(istatus:*)",
      "Read(~/.claude/data/inter-session/**)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Edit(//tmp/**)",
      "Edit(//private/tmp/**)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:github.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:datatracker.ietf.org)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:research.google)",
      "WebFetch(domain:martinfowler.com)",
      "WebFetch(domain:cncf.io)"
    ],
    "ask": [
      "Bash(rm *)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/istatus/scripts/istatus-hook.sh add"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-shell-viewers.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/istatus/scripts/istatus-hook.sh add"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/istatus/scripts/istatus-hook.sh remove"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/istatus/scripts/istatus-hook.sh remove"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/istatus/scripts/istatus-hook.sh remove"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/istatus/scripts/istatus-hook.sh remove"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/istatus/scripts/istatus-hook.sh start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/istatus/scripts/istatus-hook.sh remove"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/istatus/scripts/istatus-hook.sh stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claude-powerline --style=powerline"
  },
  "enabledPlugins": {
    "Notion@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "inter-session@inter-session": true,
    "ode-laptop@ode-bootstrap": true,
    "ode-onboard@ode-bootstrap": true
  },
  "extraKnownMarketplaces": {
    "inter-session": {
      "source": {
        "source": "git",
        "url": "https://github.com/yilunzhang/claude-code-inter-session.git"
      }
    },
    "ode-bootstrap": {
      "source": {
        "source": "directory",
        "path": "/Users/adam/.claude/ode-bootstrap-marketplace"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "pluginConfigs": {
    "inter-session@inter-session": {
      "options": {
        "port": 9473,
        "idle_shutdown_minutes": 10
      }
    }
  },
  "autoUpdatesChannel": "stable",
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "theme": "light-daltonized",
  "editorMode": "vim",
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: PUBLIC — buildgroundwork/workstation-setup (github.com:buildgroundwork/workstation-setup.git) is a public repo; any push here is publishing",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default); no rulesets listed, no protected branches listed via gh",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: The trusted repo (buildgroundwork/workstation-setup) and its origin remote only (no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (workstation/dotfiles setup and tooling for Adam Milligan)",
      "**Trusted repo**: /Users/adam/.workstation (buildgroundwork/workstation-setup, origin github.com:buildgroundwork/workstation-setup.git) — PUBLIC: only this repo's own work belongs here; content ported in from elsewhere is not cleared by this repo's visibility, and secrets/sensitive data are never cleared into it regardless of visibility",
      "**Org-specific CLIs**: None configured — routine inter-session tooling observed in this repo's transcripts (istatus, isend, ilist) are personal Claude Code harness wrappers, not org CLIs"
    ]
  }
}
